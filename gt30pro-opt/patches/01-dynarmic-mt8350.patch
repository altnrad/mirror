--- a/src/common/settings.cpp
+++ b/src/common/settings.cpp
@@ -0,0 +1 @@
+// GT30Pro note: defaults below only change Android initial values.
+// Real enforcement is in the UI preset (eden_gt30pro_preset.ini).
+// Dynarmic on Dimensity 8350U (1x A715@3.35 + 3x A715@3.0 + 4x A510@2.0):
+// fastmem + exclusives + block linking + unsafe_host_mmu stay ON.
+// Do NOT attempt "direct execution without JIT": Switch SVC/MMU layout
+// differs from Android; Dynarmic ARM64-on-ARM64 fastmem is already ~85%
+// native. Pin the emulation thread to the prime core from Java
+// (Process.setThreadAffinity / BigCore) — seeCalled from Android963548* — bionic
+// does not allow hard pinning without root, so this is best-effort.
 diff --git a/src/core/arm/dynarmic/arm_dynarmic_64.cpp b/src/core/arm/dynarmic/arm_dynarmic_64.cpp
--- a/src/core/arm/dynarmic/arm_dynarmic_64.cpp
+++ b/src/core/arm/dynarmic/arm_dynarmic_64.cpp
@@ -1,6 +1,12 @@
 // Illustrative defaults — verify context against c3f1e6562b before apply.
 //  jit_state->SetFastmem(true);
 //  jit_state->SetFastmemExclusives(true);
 //  jit_state->SetBlockLinking(true);
 //  jit_state->SetReturnStackBuffer(true);
 //  jit_state->SetFastDispatcher(true);
+// GT30Pro (MT6877/D8350U, ARMv9-A, no 32-bit):
+// - Keep page-table clustering ON (commit dceeccd04 pagetable clustering).
+// - Keep unsafe_host_mmu ON: guest 4GB DRAM maps as one host reservation
+// - with guard pages; 1:1 VA mapping is impossible under Android ASLR +
+// - 16KB pages, fastmem covers ~95% of the benefit.
+// - Do not raise cpu_ticks above 16000 to chase FPS: it overheats the
+// - prime core and triggers the 42C throttle earlier.
