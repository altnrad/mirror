--- a/src/video_core/renderer_vulkan/vk_render_pass_cache.cpp
+++ b/src/video_core/renderer_vulkan/vk_render_pass_cache.cpp
@@ -1,4 +1,16 @@
 // GT30Pro Mali-G615 (Valhall 5, TBR) guidance — verify against c3f1e6562b.
+// Goal: keep depth/color inside tile SRAM, avoid DRAM store/load each frame.
+// - Prefer D24_UNORM_S8_UINT over D32_SFLOAT_S8 on Mali (half bandwidth).
+// - Depth loadOp=CLEAR storeOp=DONT_CARE when no later read (shadow maps
+// - recreated per frame in BOTW). Lets the driver skip tile writeback.
+// - Merge color+resolve into one subpass (subpass merging) instead of two
+// - render passes; reduces framebuffer switches which flush tiles on Mali.
+// - No Turnip/Adreno path exists on this device (Turnip = Mesa/Linux only),
+// - so nothing to "disable" — just don't enable MSAA/sample shading here.
 --- a/src/video_core/renderer_vulkan/vk_texture_cache.cpp
 +++ b/src/video_core/renderer_vulkan/vk_texture_cache.cpp
 @@ -1 +1 @@
-// fallback depth-comparison sampler removed in fa4e7c69 — BOTW black Link
+// NOTE fa4e7c6992 dropped the depth-comparison sampler fallback (fixes Alan
+// Wake flashlight, breaks BOTW shadows on some Mali drivers). If Link stays
+// black on G615: force the shadow sampler to CompareOp LessOrEqual with
+// unmipped D24, or ship the per-game "low shadows" mod as workaround until
+// upstream restores a Mali-safe path. Do not force D32 — doubles bandwidth.
